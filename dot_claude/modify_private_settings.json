{{- /* chezmoi:modify-template */ -}}
{{- /*
  Claude Code also writes to this file (approved permissions, etc.), so
  chezmoi only sets the keys below and keeps everything else as it is.
  SONAR_TOKEN comes from the local chezmoi config (sonarToken in
  ~/.config/chezmoi/chezmoi.toml) and never goes to git.
*/ -}}
{{- $settings := dict -}}
{{- if .chezmoi.stdin | trim -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $settings = setValueAtPath "theme" "dark" $settings -}}
{{- $settings = setValueAtPath "skipDangerousModePermissionPrompt" true $settings -}}
{{- /*
  Session state in the tmux window name, ◌ working and ? waiting for you
  (~/.claude/hooks/tmux-status.sh), and
  a desktop notification when the terminal is not focused (notify.sh).
  chezmoi owns each event below: hooks added to them by hand are replaced on
  the next apply. Other events are kept.
  Spec: matcher, tmux-status argument, notify.sh argument ("" = none).
*/ -}}
{{- range $event, $spec := dict
      "UserPromptSubmit" (list "" "◌" "")
      "PostToolUse" (list "*" "◌" "")
      "PreToolUse" (list "AskUserQuestion" "'?'" "waiting")
      "Notification" (list "permission_prompt|elicitation_dialog" "'?'" "waiting")
      "Stop" (list "" "clear" "done")
      "StopFailure" (list "" "clear" "")
      "SessionEnd" (list "" "reset" "") -}}
{{-   $hooks := list (dict "type" "command" "command" (printf "~/.claude/hooks/tmux-status.sh %s" (index $spec 1))) -}}
{{-   if index $spec 2 -}}
{{-     $hooks = append $hooks (dict "type" "command" "async" true "command" (printf "~/.claude/hooks/notify.sh %s" (index $spec 2))) -}}
{{-   end -}}
{{-   $entry := dict "hooks" $hooks -}}
{{-   if index $spec 0 -}}{{- $entry = set $entry "matcher" (index $spec 0) -}}{{- end -}}
{{-   $settings = setValueAtPath (printf "hooks.%s" $event) (list $entry) $settings -}}
{{- end -}}
{{- $token := get . "sonarToken" -}}
{{- if $token -}}
{{-   $settings = setValueAtPath "env.SONAR_TOKEN" $token $settings -}}
{{- end -}}
{{ toPrettyJson $settings }}
