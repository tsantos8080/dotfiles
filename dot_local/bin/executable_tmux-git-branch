#!/usr/bin/env bash
# Git branch of a folder for the tmux status bar, cut at 40 characters so it
# does not push the window list away. Prints nothing outside a git repository.

branch=$(git -C "$1" branch --show-current 2>/dev/null) || exit 0
[ -n "$branch" ] || exit 0

max=40
[ ${#branch} -gt $max ] && branch="${branch:0:max-1}…"
echo " $branch  "
