{{- template "shebang" . }}
if command -v mise > /dev/null 2>&1; then
	echo -e "\e[32mmise is already installed. skipping...\e[0m"
else
	{{- if eq .chezmoi.os "darwin" }}
	brew install mise
	{{- else }}
	installer=$(mktemp)
	trap 'rm -f "$installer"' EXIT
	curl -fsSL https://mise.run -o "$installer"
	MISE_VERSION=v2026.10.0 sh "$installer"
	{{- end }}

fi

# Configure
mise trust "$HOME/.config/mise/config.toml"

{{- if eq .chezmoi.os "darwin" }}
PHP_CONFIGURE_OPTIONS="--with-iconv=$(brew --prefix libiconv) --with-openssl=$(brew --prefix openssl)" \
	mise install --yes
{{- else }}
mise install --yes
{{- end }}

echo '[dotfiles] Ferramentas instaladas. Abra um novo terminal para ativar o shell.'
