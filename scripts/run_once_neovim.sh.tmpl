{{- template "shebang" . }}

# nvim itself comes from mise (neovim in ~/.config/mise/config.toml). This
# installs what the plugins need: a C compiler for treesitter parsers, PHP and
# Composer for the PHP tooling, and pynvim for UltiSnips.
{{- if eq .chezmoi.os "darwin" }}
if brew list pyvim > /dev/null 2>&1; then
	echo -e "\e[32mneovim plugin dependencies are already installed. skipping...\e[0m"
else
	brew install pyvim
fi
{{- else }}
if dpkg -s build-essential php-cli composer python3-pip python3-pynvim > /dev/null 2>&1; then
	echo -e "\e[32mneovim plugin dependencies are already installed. skipping...\e[0m"
else
	sudo apt install -y build-essential php-cli composer python3 python3-pip python3-pynvim
fi
{{- end }}

{{ if eq .chezmoi.os "linux" -}}
if ! nvm --version > /dev/null 2>&1; then
	echo -e "\e[32mnvm is already installed. skipping...\e[0m"
else
	curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash

	nvm install v22 && nvm use v22

	source ~/.bashrc
	source ~/.zshrc
fi
{{- end -}}

